# NovBot local demo environment — DEMO ONLY (not for production).
# Copy to demo/.env (gitignored) and adjust. Never commit real secrets.
#
#   cp demo/.env.example demo/.env

# --- MySQL (docker compose) ---
# DEMO-ONLY defaults. Change before any shared or networked use.
MYSQL_ROOT_PASSWORD=demo-root-change-me
MYSQL_DATABASE=novbot
MYSQL_USER=novbot
MYSQL_PASSWORD=demo-novbot-change-me
MYSQL_HOST_PORT=3306

# Center database URL (must match MySQL user/password/db/port above)
NOVBOT_DATABASE_URL=mysql://novbot:demo-novbot-change-me@127.0.0.1:3306/novbot

# --- HTTP API auth (recommended ON for demo) ---
# When set, all /v1/* routes require: Authorization: Bearer <token>
# /health stays open. Leave empty only for throwaway local debugging.
NOVBOT_API_TOKEN=demo-api-token-change-me

# Optional: require matching token on node Register (gRPC)
NOVBOT_BOOTSTRAP_TOKEN=demo-bootstrap-change-me

# Optional stub license (opens EE report stubs)
# NOVBOT_LICENSE_KEY=dev-license

# --- Listen addresses / ports ---
NOVBOT_HTTP_ADDR=0.0.0.0:8080
NOVBOT_GRPC_ADDR=0.0.0.0:50051
NOVBOT_HTTP_PORT=8080
NOVBOT_GRPC_PORT=50051

# Console Vite (optional)
# VITE_DEV_PORT=5173
